#!/usr/bin/env bash
set -Eeuo pipefail

source /etc/ade/agent-environment.env

ade_bin=/usr/local/bin/ade
[[ -x "$ade_bin" ]] || { echo "ADE Go binary is unavailable: $ade_bin" >&2; exit 1; }
[[ -f "$ADE_SOURCE_ROOT/web/dist/ui/index.html" ]] || {
  echo "dashboard build is missing under $ADE_SOURCE_ROOT/web/dist/ui" >&2
  exit 1
}

exec "$ade_bin" environment serve "$@"
