#!/usr/bin/env bash
set -Eeuo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

[[ $(id -u) == 0 ]] || { echo 'agent-environment-cd-install must run as root' >&2; exit 1; }
[[ -f /etc/ade/agent-environment.env ]] || {
  echo 'Install the Agent Development Environment service before enabling its CD timer.' >&2
  exit 1
}
id orca >/dev/null 2>&1 || { echo 'The orca service account is missing.' >&2; exit 1; }

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
install -d -o root -g root -m 0700 /var/lib/ade-agent-environment-cd
install -d -o orca -g orca -m 0700 \
  /home/orca/.local/share/ade-deployments \
  /home/orca/.cache/agent-environment-cd/npm
install -o root -g root -m 0755 \
  "$script_dir/agent-environment-cd-pull" \
  /usr/local/sbin/agent-environment-cd-pull
install -o root -g root -m 0644 \
  "$script_dir/agent-environment-cd.service" \
  /etc/systemd/system/agent-environment-cd.service
install -o root -g root -m 0644 \
  "$script_dir/agent-environment-cd.timer" \
  /etc/systemd/system/agent-environment-cd.timer

systemctl daemon-reload
systemctl enable --now agent-environment-cd.timer
echo 'Enabled CI/CD polling from the GitHub deploy branch.'
