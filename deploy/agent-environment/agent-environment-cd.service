[Unit]
Description=Deploy the CI-verified Agent Development Environment release
After=network-online.target agent-environment.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/agent-environment-cd-pull
TimeoutStartSec=20min
UMask=0022
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/ade /home/orca/.local/share/ade-deployments /home/orca/.cache/agent-environment-cd /var/lib/ade-agent-environment-cd
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
